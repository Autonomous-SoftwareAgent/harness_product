{
  "_": "Tệp tự khai của khối. Đường dẫn trong tệp là đường dẫn logic (tính như ở .claude/modules/ của bố cục cũ). Bộ cài (cli/setup.js) sinh phần của harness trong .claude/settings.json và .mcp.json từ các tệp này; `order` giữ thứ tự hook như đã đo.",
  "name": "core",
  "version": "2.9.0",
  "api": "0.1",
  "required": true,
  "uses": [],
  "does": "cổng duyệt kế hoạch, phạm vi theo kế hoạch, chặn theo skill, sổ phiên, bảng phiên, tóm tắt đầu phiên, máy chủ MCP, bộ cài, doctor, onboard",
  "hooks": [
    { "event": "PreToolUse", "order": 10, "matcher": "Write|Edit|NotebookEdit", "file": "hooks/guard-scope.js", "timeout": 10 },
    { "event": "PreToolUse", "order": 15, "matcher": "Write|Edit|NotebookEdit|Bash", "file": "hooks/guard-host.js", "timeout": 10 },
    { "event": "PreToolUse", "order": 30, "matcher": "Write|Edit|NotebookEdit|Bash", "file": "gate/gate-hook.js", "args": "tool", "timeout": 10 },
    { "event": "PreToolUse", "order": 35, "matcher": "Read|Grep|Glob", "file": "gate/gate-hook.js", "args": "read", "timeout": 10 },
    { "event": "PreToolUse", "order": 40, "matcher": "Write|Edit|NotebookEdit|@mcp", "file": "hooks/guard-skill.js", "timeout": 10 },
    { "event": "PreToolUse", "order": 45, "matcher": "@mcp", "file": "hooks/guard-delegate.js", "timeout": 10 },
    { "event": "PreToolUse", "order": 50, "matcher": "mcp__.*", "file": "hooks/guard-mcp.js", "timeout": 10 },
    { "event": "PostToolUse", "order": 10, "matcher": "Write|Edit|NotebookEdit", "file": "hooks/forward.js", "args": "track", "timeout": 10 },
    { "event": "PostToolUse", "order": 12, "matcher": "Write|Edit|NotebookEdit", "file": "hooks/host-resync.js", "timeout": 10 },
    { "event": "PostToolUse", "order": 20, "file": "hooks/ledger.js", "args": "record", "timeout": 10 },
    { "event": "Stop", "order": 10, "file": "hooks/forward.js", "args": "stop", "timeout": 60, "statusMessage": "Checking docs are in sync..." },
    { "event": "Stop", "order": 20, "file": "gate/gate-hook.js", "args": "stop", "timeout": 10 },
    { "event": "UserPromptSubmit", "order": 10, "file": "gate/gate-hook.js", "args": "prompt", "timeout": 90, "statusMessage": "Checking approval..." },
    { "event": "UserPromptSubmit", "order": 20, "file": "hooks/ledger.js", "args": "prompt", "timeout": 10 },
    { "event": "UserPromptSubmit", "order": 30, "file": "hooks/reload.js", "args": "prompt", "timeout": 10 },
    { "event": "UserPromptSubmit", "order": 40, "file": "hooks/transfer.js", "args": "prompt", "timeout": 10 },
    { "event": "SessionStart", "order": 10, "file": "gate/gate-hook.js", "args": "health", "timeout": 15 },
    { "event": "SessionStart", "order": 20, "file": "hooks/session-brief.js", "timeout": 10 },
    { "event": "SessionStart", "order": 30, "file": "hooks/ledger.js", "args": "start", "timeout": 10 },
    { "event": "SessionStart", "order": 40, "file": "hooks/reload.js", "args": "start", "timeout": 10 },
    { "event": "SessionStart", "order": 50, "file": "hooks/transfer.js", "args": "start", "timeout": 10 }
  ],
  "mcpServer": { "file": "mcp/mcp-server.js", "blocks": ["core", "mcp"] },
  "permissions": { "allow": ["@mcp-servers"] },
  "provides": {
    "mcpTools": "mcp/mcp-tools.js",
    "yaml": "core/lib/yaml-lite.js",
    "gitHooks": "cli/install-git-hooks.js",
    "bannedScan": "cli/banned-scan.js"
  },
  "skills": ["services", "plan", "new-service", "onboard", "skill-map", "transfer-session", "mcp-servers", "harness-upgrade", "orchestrate"]
}
