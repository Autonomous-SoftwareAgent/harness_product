{
  "name": "secrets",
  "version": "1.0.0",
  "api": "0.1",
  "uses": ["core"],
  "does": "kho bí mật của máy (token GitHub) theo hệ điều hành, vòng đời token, công cụ GitHub cho agent theo kế hoạch đang duyệt",
  "mcpBlock": "secrets",
  "tools": [{ "file": "mcp/secrets/tools.js", "order": 60 }],
  "commands": ["cli/commands/secret.js"],
  "hooks": [
    { "event": "PreToolUse", "order": 65, "matcher": "Bash", "file": "hooks/guard-github.js", "timeout": 15 },
    { "event": "SessionStart", "order": 60, "file": "hooks/secrets-brief.js", "timeout": 15 }
  ]
}
